# Documentation template only; not loaded automatically by the app.
# Keep real values in the hosting environment, never source control.
NODE_ENV=production
PUBLIC_ORIGIN=https://REPLACE-WITH-APPROVED-SERVICE.onrender.com
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
TRUST_PROXY_HOPS=1
QUOTETEND_DB=/var/data/accounts.sqlite
QUOTETEND_BACKUP_DIR=/var/data/backups
TZ=America/Chicago
PORT=10000
